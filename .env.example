# Dev stack (docker-compose.yml) settings. scripts/dev-init.sh writes .env with fresh random credentials;
# this file lists the keys only. Never commit .env.
PG_PASSWORD=
SERVE_S3_ACCESS_KEY=
SERVE_S3_SECRET_KEY=
INGEST_S3_ACCESS_KEY=
INGEST_S3_SECRET_KEY=
RMQ_PASSWORD=
INTERNAL_TOKEN=
# Referer the Nodely algod accepts for the scanner (ask the operator)
ALGOD_REFERER=
# Referer used by scripts/shadow-compare.py against the old gateway
SHADOW_REFERER=
